+  delete: (id: string): void => {
+    if (!drawings.has(id)) return;
+    drawings.delete(id);
+    emit("drawing.delete", id, {});
+  },
+};
+
+export type LabelStyle =
+  | "label_left"
+  | "label_right"
+  | "label_up"
+  | "label_down"
