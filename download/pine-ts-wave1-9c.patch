+
+/** `table.new(position, columns, rows, ...)`. Returns the table's id. */
+export const table = {
+  new: (
+    position: TablePosition,
+    columns: number,
+    rows: number,
+    options: { bgcolor?: Color; border_width?: number; border_color?: Color } = {},
+  ): string => {
