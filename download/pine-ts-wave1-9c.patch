+
+const makeBars = (closes: number[]): Bar[] =>
+  closes.map((c, i) => ({
+    time: (i + 1) * 1000,
+    open: c,
+    high: c,
+    low: c,
+    close: c,
+    volume: 1,
+    isClosed: true,
+  }));
+
+const makeOhlcvBars = (
+  rows: ReadonlyArray<{ o: number; h: number; l: number; c: number; v: number }>,
+): Bar[] =>
+  rows.map((r, i) => ({
+    time: (i + 1) * 1000,
+    open: r.o,
+    high: r.h,
+    low: r.l,
+    close: r.c,
+    volume: r.v,
+    isClosed: true,
+  }));
+
+const runScript = async (
+  closes: number[],
+  script: (ctx: import("../src/index.js").PineContext) => void,
