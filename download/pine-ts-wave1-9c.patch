+/**
+ * Tests for Wave 7 visual runtime: plot*, hline, fill, bgcolor, barcolor,
+ * alertcondition (already covered in Wave 4), drawing objects.
+ */
+import { beforeEach, describe, expect, it } from "vitest";
+import * as visual from "../src/visual/index.js";
+import { color as colorNs } from "../src/index.js";
+
+describe("visual runtime", () => {
+  beforeEach(() => {
+    visual.resetVisualState();
+    visual.setVisualSink(undefined);
+  });
+
+  // ---------- plot / plotshape / plotchar / plotarrow ----------
+
+  describe("plot family", () => {
+    it("plot emits a 'plot' event with the value and styling", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.plot(42.5, "myplot", { color: colorNs.rgb(255, 0, 0), linewidth: 2 });
+      visual.plot(43.0, "myplot"); // same seriesId — should append a second event
+      expect(events).toHaveLength(2);
+      expect(events[0]?.kind).toBe("plot");
+      expect(events[0]?.seriesId).toBe("myplot");
+      expect(events[0]?.payload["value"]).toBe(42.5);
+      expect(events[0]?.payload["linewidth"]).toBe(2);
+      expect(events[1]?.payload["value"]).toBe(43.0);
+      // Default linewidth is 1 when not supplied.
+      expect(events[1]?.payload["linewidth"]).toBe(1);
+    });
+
+    it("plotshape does not emit when condition is false", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.plotshape(false);
+      expect(events).toHaveLength(0);
+    });
+
+    it("plotshape emits when condition is true, with shape defaults", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.plotshape(true, { title: "arrow", style: "shapearrowup" });
+      expect(events).toHaveLength(1);
+      expect(events[0]?.kind).toBe("plotshape");
+      expect(events[0]?.seriesId).toBe("arrow");
+      expect(events[0]?.payload["style"]).toBe("shapearrowup");
+      expect(events[0]?.payload["location"]).toBe("abovebar");
+    });
+
+    it("plotchar emits the documented char default", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.plotchar(true, { char: "X" });
+      expect(events[0]?.kind).toBe("plotchar");
+      expect(events[0]?.payload["char"]).toBe("X");
+    });
+
+    it("plotbar and plotcandle emit OHLC payloads", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.plotbar(1, 2, 0.5, 1.5);
+      visual.plotcandle(1, 2, 0.5, 1.5);
+      expect(events).toHaveLength(2);
+      expect(events[0]?.payload["open"]).toBe(1);
+      expect(events[0]?.payload["high"]).toBe(2);
+      expect(events[1]?.payload["close"]).toBe(1.5);
+    });
+  });
+
+  // ---------- hline / fill / bgcolor / barcolor ----------
+
+  describe("hline family", () => {
+    it("hline returns an id and emits the price + style", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.hline(50, "midline", { linestyle: "dashed" });
+      expect(typeof id).toBe("string");
+      expect(events[0]?.kind).toBe("hline");
+      expect(events[0]?.seriesId).toBe(id);
+      expect(events[0]?.payload["price"]).toBe(50);
+      expect(events[0]?.payload["linestyle"]).toBe("dashed");
+    });
+
+    it("fill emits the two hline ids + a color", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id1 = visual.hline(50);
+      const id2 = visual.hline(60);
+      visual.fill(id1, id2, { color: colorNs.rgb(0, 255, 0) });
+      expect(events.at(-1)?.kind).toBe("fill");
+      expect(events.at(-1)?.payload["hline1"]).toBe(id1);
+      expect(events.at(-1)?.payload["hline2"]).toBe(id2);
+    });
+
+    it("bgcolor emits the color", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.bgcolor(colorNs.rgb(255, 255, 0));
+      expect(events[0]?.kind).toBe("bgcolor");
+      expect(events[0]?.payload["color"]).toEqual({ r: 255, g: 255, b: 0, t: 0 });
+    });
+
+    it("barcolor emits the color", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.barcolor(colorNs.rgb(255, 0, 0));
+      expect(events[0]?.kind).toBe("barcolor");
+    });
+  });
+
+  // ---------- drawing objects ----------
+
+  describe("drawing objects", () => {
+    it("line.new returns an id and emits a create event", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.line.new(1, 100, 10, 110);
+      expect(typeof id).toBe("string");
+      expect(events[0]?.kind).toBe("drawing.create");
+      expect(events[0]?.payload["drawingKind"]).toBe("line");
+      expect(events[0]?.payload["x1"]).toBe(1);
+    });
+
+    it("line.set_x1 emits an update event", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.line.new(1, 100, 10, 110);
+      visual.line.set_x1(id, 5);
+      expect(events.at(-1)?.kind).toBe("drawing.update");
+      expect(events.at(-1)?.payload["field"]).toBe("x1");
+      expect(events.at(-1)?.payload["value"]).toBe(5);
+    });
+
+    it("line.delete emits a delete event", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.line.new(1, 100, 10, 110);
+      visual.line.delete(id);
+      expect(events.at(-1)?.kind).toBe("drawing.delete");
+      expect(events.at(-1)?.seriesId).toBe(id);
+    });
+
+    it("line.get_price linearly interpolates between endpoints", () => {
+      visual.line.new(0, 100, 10, 110, {});
+      // Need to look up the line by its id; line.new returns an id.
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.line.new(0, 100, 10, 110);
+      // At x=5, the line is halfway between y1=100 and y2=110 → 105.
+      expect(visual.line.get_price(id, 5)).toBeCloseTo(105, 5);
+    });
+
+    it("label.new creates a drawing; set_text emits an update", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.label.new(1, 100, "hello");
+      expect(events[0]?.payload["text"]).toBe("hello");
+      visual.label.set_text(id, "world");
+      expect(events.at(-1)?.kind).toBe("drawing.update");
+      expect(events.at(-1)?.payload["value"]).toBe("world");
+    });
+
+    it("box.new creates a drawing; setters emit updates", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.box.new(0, 100, 10, 90);
+      expect(events[0]?.payload["top"]).toBe(100);
+      visual.box.set_top(id, 105);
+      expect(events.at(-1)?.payload["field"]).toBe("top");
+    });
+
+    it("table.new + table.cell emits create + update", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      const id = visual.table.new("top_left", 3, 2);
+      expect(events[0]?.payload["columns"]).toBe(3);
+      visual.table.cell(id, 0, 0, "AAPL");
+      expect(events.at(-1)?.payload["field"]).toBe("cell");
+    });
+
+    it("linefill.new creates a linefill drawing", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.linefill.new("l1", "l2", colorNs.rgb(0, 0, 255));
+      expect(events[0]?.kind).toBe("drawing.create");
+      expect(events[0]?.payload["drawingKind"]).toBe("linefill");
+      expect(events[0]?.payload["color"]).toEqual({ r: 0, g: 0, b: 255, t: 0 });
+    });
+
+    it("polyline.new creates a polyline drawing from points", () => {
+      const events: visual.VisualEvent[] = [];
+      visual.setVisualSink((e) => events.push(e));
+      visual.polyline.new(
+        [{ index: 0, price: 100 }, { index: 1, price: 110 }, { index: 2, price: 105 }],
+        { color: colorNs.rgb(255, 0, 0), line_width: 2 },
+      );
+      expect(events[0]?.kind).toBe("drawing.create");
+      expect(events[0]?.payload["drawingKind"]).toBe("polyline");
+      expect(events[0]?.payload["line_width"]).toBe(2);
+    });
+
+    it("chartPoint.from_time and from_index return the expected shapes", () => {
+      const p1 = visual.chartPoint.from_time(1000, 50.5);
+      expect(p1).toEqual({ time: 1000, price: 50.5, index: undefined });
+      const p2 = visual.chartPoint.from_index(5, 60);
+      expect(p2).toEqual({ time: undefined, price: 60, index: 5 });
+    });
+
+    it("drawings_all returns all created drawing ids", () => {
+      const id1 = visual.line.new(0, 100, 10, 110);
+      const id2 = visual.label.new(1, 100, "hi");
+      const all = visual.drawings_all();
+      expect(all).toContain(id1);
+      expect(all).toContain(id2);
+    });
+
+    it("silently no-ops when no sink is installed", () => {
+      visual.setVisualSink(undefined);
+      expect(() => visual.plot(42)).not.toThrow();
+      expect(() => visual.line.new(0, 100, 10, 110)).not.toThrow();
+    });
+  });
+});
diff --git a/tests/wave8-request-security.test.ts b/tests/wave8-request-security.test.ts
new file mode 100644
index 0000000..7bc45f6
--- /dev/null
+++ b/tests/wave8-request-security.test.ts
@@ -0,0 +1,378 @@
+/**
+ * Tests for the multi-context execution engine backing
+ * `request.security` / `request.security_lower_tf`.
+ *
+ * The HTF (higher-timeframe) test scenarios use synthetic minute-scale
+ * caller bars and a 5-minute HTF context, exercising:
+ *  - Default `lookahead=off` (non-repainting): result is the latest
+ *    closed HTF bar at the caller's bar time.
+ *  - `lookahead=on` (repainting): result is the HTF bar containing the
+ *    caller's bar time.
+ *  - `gaps=on` vs `gaps=off` fallback when no alignment is available.
+ *  - Per-expression caching: the same expression across caller bars
+ *    re-uses cached values rather than re-driving the secondary session.
+ *  - `RequestNotPrepared` when the host did not pre-warm a pair.
+ *  - `security_lower_tf` returns intrabar values within the caller bar.
+ */
+import { describe, expect, it } from "vitest";
+import { PineRuntime, request, ta } from "../src/index.js";
+import type { Bar, MarketDataProvider, SymbolInfo } from "../src/index.js";
+
+// ---------- shared harness ----------
+
+const testInfo: SymbolInfo = {
+  ticker: "TEST",
+  tickerId: "TEST:TEST",
+  minTick: 0.01,
+  timezone: "UTC",
+};
+
+/** A provider that returns pre-built bars for any (symbol, timeframe) pair. */
+class FixtureProvider implements MarketDataProvider {
+  private readonly barsByPair = new Map<string, Bar[]>();
+  private readonly symbolInfo = new Map<string, SymbolInfo>();
+
+  public constructor() {
+    this.symbolInfo.set("TEST", testInfo);
+    this.symbolInfo.set("OTHER", { ...testInfo, ticker: "OTHER" });
+  }
+
+  public addBars(symbol: string, timeframe: string, bars: Bar[]): void {
+    this.barsByPair.set(`${symbol}|${timeframe}`, bars);
+  }
+
+  public getHistoricalBars = async (req: {
+    symbol: string;
+    timeframe: string;
+  }): Promise<readonly Bar[]> => {
+    const key = `${req.symbol}|${req.timeframe}`;
+    const bars = this.barsByPair.get(key);
+    if (bars === undefined) {
+      throw new Error(`FixtureProvider: no bars for ${key}; call addBars first`);
+    }
+    return bars;
+  };
+
+  public streamBars = (): AsyncIterable<Bar> => ({
+    [Symbol.asyncIterator]: async function* () {
+      yield* [];
+    },
+  });
+
+  public getSymbolInfo = async (symbol: string): Promise<SymbolInfo> => {
+    const info = this.symbolInfo.get(symbol);
+    if (info === undefined) throw new Error(`Unknown symbol ${symbol}`);
+    return info;
+  };
+}
+
+const bar = (
+  t: number,
+  o: number,
+  h: number,
+  l: number,
+  c: number,
+  isClosed = true,
+): Bar => ({ time: t, open: o, high: h, low: l, close: c, volume: 1, isClosed });
+
+// Build 5 caller bars of 1-minute duration starting at t=60_000 (00:01:00 UTC).
+// Each caller bar covers [t, t+60s). The HTF (5-minute) bar covers [0, 5min).
+// Caller bar 0 at t=60_000: time within HTF bar 0 [0..300_000).
+// Caller bar 4 at t=300_000: at the boundary; HTF bar 0's close = 300_000.
+//   - lookahead=off → alignment is HTF bar -1 (none, returns na on gaps=on or last cached on gaps=off).
+//   - lookahead=on → alignment is HTF bar 0 (containing t=300_000? open<=t<close → 0<=300<300 is false, so no).
+// Actually HTF bar 0 has open=0, close=300_000; for t=300_000, lookahead_on checks open<=t<close → 0<=300_000<300_000 is false, so no containing bar. So both lookahead settings return na at t=300_000.
+// Caller bar 5 at t=360_000: time within HTF bar 1 [300_000..600_000).
+
+const callerBars: Bar[] = [
+  bar(60_000, 10, 11, 9, 10),
+  bar(120_000, 10, 12, 8, 11),
+  bar(180_000, 11, 13, 10, 12),
+  bar(240_000, 12, 14, 11, 13),
+  bar(300_000, 13, 15, 12, 14),
+  bar(360_000, 14, 16, 13, 15),
+];
+
+const htfBars: Bar[] = [
+  bar(0, 10, 15, 9, 14), // HTF bar 0 covers [0..300_000)
+  bar(300_000, 14, 17, 13, 16), // HTF bar 1 covers [300_000..600_000)
+  bar(600_000, 16, 20, 14, 18), // HTF bar 2 covers [600_000..900_000)
+];
+
+describe("request.security (multi-context execution engine)", () => {
+  // ---------- not pre-warmed ----------
+
+  describe("without pre-warming", () => {
+    it("throws RequestNotPrepared when the pair was not pre-warmed", async () => {
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "1", callerBars);
+      provider.addBars("TEST", "5", htfBars);
+      const runtime = new PineRuntime({
+        provider,
+        symbol: "TEST",
+        timeframe: "1",
+      });
+      // Don't call prepareSecurity; the script's request.security should fail.
+      await expect(
+        runtime.run((_ctx) => {
+          request.security("TEST", "5", (sctx) => sctx.close.at(0));
+        }, callerBars),
+      ).rejects.toBeInstanceOf(request.RequestNotPrepared);
+    });
+  });
+
+  // ---------- HTF alignment: lookahead=off (default) ----------
+
+  describe("HTF request, lookahead=off (non-repainting)", () => {
+    it("returns the latest closed HTF bar value at the caller's bar time", async () => {
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "1", callerBars);
+      provider.addBars("TEST", "5", htfBars);
+      const runtime = new PineRuntime({
+        provider,
+        symbol: "TEST",
+        timeframe: "1",
+      });
+      await runtime.prepareSecurity("TEST", "5");
+
+      const captured: Array<{ callerTime: number | undefined; htfClose: number | undefined }> = [];
+      await runtime.run((ctx) => {
+        const htfClose = request.security("TEST", "5", (sctx) => sctx.close.at(0));
+        captured.push({ callerTime: ctx.time.at(0), htfClose });
+      }, callerBars);
+
+      // caller[0]=t=60_000 (within HTF bar 0). lookahead=off: latest closed HTF
+      // bar whose close_time ≤ 60_000 → HTF bar -1 (none); gaps=off returns last
+      // cached, which is undefined on the first call.
+      expect(captured[0]?.htfClose).toBeUndefined();
+
+      // caller[1]=t=120_000 (within HTF bar 0). Still no closed HTF bar before
+      // 120_000 → undefined.
+      expect(captured[1]?.htfClose).toBeUndefined();
+
+      // caller[4]=t=300_000 (boundary). HTF bar 0's close=300_000 ≤ 300_000 →
+      // alignment is HTF bar 0, value=close=14.
+      expect(captured[4]?.htfClose).toBe(14);
+
+      // caller[5]=t=360_000 (within HTF bar 1). HTF bar 0 closed at 300_000 ≤
+      // 360_000 → alignment is HTF bar 0, value=close=14 (still the most recent
+      // closed HTF bar).
+      expect(captured[5]?.htfClose).toBe(14);
+    });
+
+    it("caches per-expression results so subsequent caller bars don't re-drive the secondary session", async () => {
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "1", callerBars);
+      provider.addBars("TEST", "5", htfBars);
+      const runtime = new PineRuntime({
+        provider,
+        symbol: "TEST",
+        timeframe: "1",
+      });
+      await runtime.prepareSecurity("TEST", "5");
+
+      let evaluationCount = 0;
+      const expression = (sctx: { close: { at: (n: number) => number | undefined } }) => {
+        evaluationCount += 1;
+        return sctx.close.at(0);
+      };
+      await runtime.run(() => {
+        request.security("TEST", "5", expression);
+      }, callerBars);
+      // The expression should be evaluated exactly once per secondary bar
+      // (3 HTF bars) regardless of the number of caller bars (6).
+      expect(evaluationCount).toBeLessThanOrEqual(3);
+    });
+  });
+
+  // ---------- HTF alignment: lookahead=on ----------
+
+  describe("HTF request, lookahead=on (repainting)", () => {
+    it("returns the HTF bar containing the caller's bar time", async () => {
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "1", callerBars);
+      provider.addBars("TEST", "5", htfBars);
+      const runtime = new PineRuntime({
+        provider,
+        symbol: "TEST",
+        timeframe: "1",
+      });
+      await runtime.prepareSecurity("TEST", "5");
+
+      const captured: Array<{ callerTime: number | undefined; htfClose: number | undefined }> = [];
+      await runtime.run((ctx) => {
+        const htfClose = request.security(
+          "TEST",
+          "5",
+          (sctx) => sctx.close.at(0),
+          { lookahead: "lookahead_on" },
+        );
+        captured.push({ callerTime: ctx.time.at(0), htfClose });
+      }, callerBars);
+
+      // caller[0]=t=60_000 → containing HTF bar 0 (open=0, close=300_000),
+      // 0<=60_000<300_000 → bar 0, value=close=14.
+      expect(captured[0]?.htfClose).toBe(14);
+
+      // caller[4]=t=300_000 → bar 1 (open=300_000, close=600_000) contains it
+      // since 300_000<=300_000<600_000 → bar 1, value=close=16. This is the
+      // repaint: the result leaks the still-forming bar 1's close.
+      expect(captured[4]?.htfClose).toBe(16);
+
+      // caller[5]=t=360_000 → 300_000<=360_000<600_000 → bar 1, value=close=16.
+      expect(captured[5]?.htfClose).toBe(16);
+    });
+  });
+
+  // ---------- gaps handling ----------
+
+  describe("gaps handling", () => {
+    it("gaps=on returns na when no alignment bar exists; gaps=off carries forward", async () => {
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "1", callerBars);
+      provider.addBars("TEST", "5", htfBars);
+      const runtime = new FixtureProviderAsRuntime(provider);
+
+      await runtime.prepareSecurity("TEST", "5");
+
+      const gapsOn: Array<number | undefined> = [];
+      const gapsOff: Array<number | undefined> = [];
+      await runtime.run(() => {
+        gapsOn.push(
+          request.security("TEST", "5", (sctx) => sctx.close.at(0), {
+            gaps: "gaps_on",
+          }),
+        );
+        gapsOff.push(
+          request.security("TEST", "5", (sctx) => sctx.close.at(0), {
+            gaps: "gaps_off",
+          }),
+        );
+      }, callerBars);
+
+      // On the first caller bar (t=60_000), no HTF bar has closed yet, so
+      // both gaps=on and gaps=off return undefined (no cached value to carry
+      // forward on the first call).
+      expect(gapsOn[0]).toBeUndefined();
+      expect(gapsOff[0]).toBeUndefined();
+
+      // After caller[4] (t=300_000, alignment is HTF bar 0, value=14), the next
+      // caller bar returns 14 on gaps=off (carries forward) if no new
+      // alignment bar is available. With our 5-min HTF and 1-min caller, by
+      // caller[5] (t=360_000), the latest closed HTF bar is still bar 0
+      // (closed at 300_000), so both options return 14.
+      expect(gapsOff[5]).toBe(14);
+    });
+  });
+
+  // ---------- multi-symbol ----------
+
+  describe("multi-symbol request", () => {
+    it("returns the secondary symbol's close at the aligned HTF bar", async () => {
+      const otherBars: Bar[] = [
+        bar(0, 100, 110, 90, 105), // bar 0 close = 105
+        bar(300_000, 105, 115, 95, 110), // bar 1 close = 110
+      ];
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "1", callerBars);
+      provider.addBars("OTHER", "5", otherBars);
+      const runtime = new FixtureProviderAsRuntime(provider);
+      await runtime.prepareSecurity("OTHER", "5");
+
+      const captured: Array<number | undefined> = [];
+      await runtime.run(() => {
+        captured.push(
+          request.security("OTHER", "5", (sctx) => sctx.close.at(0), {
+            lookahead: "lookahead_on",
+          }),
+        );
+      }, callerBars);
+
+      // caller[0]=t=60_000 → containing HTF bar 0 → close = 105.
+      expect(captured[0]).toBe(105);
+      // caller[5]=t=360_000 → containing HTF bar 1 → close = 110.
+      expect(captured[5]).toBe(110);
+    });
+  });
+
+  // ---------- expression with ta.* built-ins ----------
+
+  describe("expression uses ta.* built-ins on the secondary context", () => {
+    it("evaluates ta.sma(close, 1) on the HTF bar (= the bar's close)", async () => {
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "1", callerBars);
+      provider.addBars("TEST", "5", htfBars);
+      const runtime = new FixtureProviderAsRuntime(provider);
+      await runtime.prepareSecurity("TEST", "5");
+
+      const captured: Array<number | undefined> = [];
+      await runtime.run(() => {
+        captured.push(
+          request.security(
+            "TEST",
+            "5",
+            (sctx) => ta.sma(sctx.close, 1).at(0),
+            { lookahead: "lookahead_on" },
+          ),
+        );
+      }, callerBars);
+
+      // At caller[0] (t=60_000), aligned to HTF bar 0 (close=14). SMA(close, 1) = 14.
+      expect(captured[0]).toBe(14);
+      // At caller[5] (t=360_000), aligned to HTF bar 1 (close=16). SMA(close, 1) = 16.
+      expect(captured[5]).toBe(16);
+    });
+  });
+
+  // ---------- security_lower_tf ----------
+
+  describe("request.security_lower_tf", () => {
+    it("returns intrabar values from the lower-tf context within the caller bar", async () => {
+      // Caller context: 5-minute bars.
+      // Lower-tf context: 1-minute bars (3 intrabars per caller bar starting at t=0, 60000, 120000).
+      const caller5MinBars: Bar[] = [
+        bar(0, 0, 0, 0, 0), // covers [0..300_000)
+        bar(300_000, 0, 0, 0, 0), // covers [300_000..600_000)
+      ];
+      const ltf1MinBars: Bar[] = [
+        bar(0, 10, 11, 9, 10),
+        bar(60_000, 11, 12, 10, 11),
+        bar(120_000, 12, 13, 11, 12),
+        bar(180_000, 13, 14, 12, 13),
+        bar(240_000, 14, 15, 13, 14),
+        bar(300_000, 15, 16, 14, 15),
+        bar(360_000, 16, 17, 15, 16),
+        bar(420_000, 17, 18, 16, 17),
+        bar(480_000, 18, 19, 17, 18),
+        bar(540_000, 19, 20, 18, 19),
+      ];
+      const provider = new FixtureProvider();
+      provider.addBars("TEST", "5", caller5MinBars);
+      provider.addBars("TEST", "1", ltf1MinBars);
+      const runtime = new FixtureProviderAsRuntime(provider);
+      await runtime.prepareSecurity("TEST", "1");
+
+      const captured: Array<readonly number[]> = [];
+      await runtime.run(() => {
+        const result = request.security_lower_tf("TEST", "1", (sctx) => sctx.close.at(0) ?? 0);
+        captured.push(result.filter((v): v is number => v !== 0));
+      }, caller5MinBars);
+
+      // Caller bar 0 (t=0..300_000): 5 intrabars (0..240_000). Their closes:
+      // 10, 11, 12, 13, 14.
+      expect(captured[0]).toEqual([10, 11, 12, 13, 14]);
+
+      // Caller bar 1 (t=300_000..600_000): 5 intrabars (300_000..540_000).
+      // Their closes: 15, 16, 17, 18, 19.
+      expect(captured[1]).toEqual([15, 16, 17, 18, 19]);
+    });
+  });
+});
+
+// ---------- helper: wrap a FixtureProvider in a PineRuntime with the right symbol/timeframe ----------
+
+class FixtureProviderAsRuntime extends PineRuntime {
+  public constructor(provider: FixtureProvider) {
+    super({ provider, symbol: "TEST", timeframe: "5" });
+  }
+}
diff --git a/tests/wave9-broker.test.ts b/tests/wave9-broker.test.ts
new file mode 100644
index 0000000..957bbf8
--- /dev/null
+++ b/tests/wave9-broker.test.ts
@@ -0,0 +1,298 @@
+/**
+ * Tests for Wave 9 — broker adapter boundary:
+ *   - PaperBrokerAdapter: in-memory broker with market/limit/stop/stop-limit fills,
+ *     commission + slippage, position reversal, pyramiding, OCA groups.
+ *   - StrategyEngine + BrokerAdapter wiring: when an adapter is installed,
+ *     entry/exit/close calls forward to the adapter instead of the emulator's
+ *     pending queue.
+ *   - BinanceBrokerAdapter: structural typing of `BinanceTradingSurface`
+ *     (the SDK's trading surface must extend it for downstream wiring).
+ */
+import { beforeEach, describe, expect, it } from "vitest";
+import {
+  PaperBrokerAdapter,
+  BinanceBrokerAdapter,
+  StrategyEngine,
+  type BrokerAdapter,
+  type OrderRequest,
+  type OrderUpdate,
+  type BinanceTradingSurface,
+  type Bar,
+} from "../src/index.js";
+
+const bar = (t: number, o: number, h: number, l: number, c: number): Bar => ({
+  time: t,
+  open: o,
+  high: h,
+  low: l,
+  close: c,
+  volume: 1,
+  isClosed: true,
+});
+
+const marketOrder = (
+  clientId: string,
+  symbol: string,
+  direction: "long" | "short",
+  qty: number,
+): OrderRequest => ({
+  clientId,
+  symbol,
+  direction,
+  qty,
+  orderType: "market",
+  limitPrice: undefined,
+  stopPrice: undefined,
+  timeInForce: "GTC",
+  isExit: false,
+  ocaName: undefined,
+});
+
+describe("PaperBrokerAdapter", () => {
+  let broker: PaperBrokerAdapter;
+  const updates: OrderUpdate[] = [];
+
+  beforeEach(() => {
+    broker = new PaperBrokerAdapter({ initialBalance: 10_000 });
+    updates.length = 0;
+    broker.onOrderUpdate((u) => updates.push(u));
+  });
+
+  // ---------- submit / cancel ----------
+
+  describe("submitOrder / cancelOrder", () => {
+    it("submitOrder returns a 'new' status and emits an update", async () => {
+      const result = await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      expect(result.status).toBe("new");
+      expect(result.clientId).toBe("o1");
+      expect(updates[0]?.status).toBe("new");
+      expect(updates[0]?.clientId).toBe("o1");
+    });
+
+    it("cancelOrder moves the order to 'canceled' and emits an update", async () => {
+      const result = await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      await broker.cancelOrder(result.orderId);
+      const lastUpdate = updates.at(-1);
+      expect(lastUpdate?.status).toBe("canceled");
+      expect(lastUpdate?.orderId).toBe(result.orderId);
+    });
+
+    it("cancelOrder on a filled order throws", async () => {
+      const result = await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      broker.processBar(bar(1, 100, 105, 95, 102));
+      await expect(broker.cancelOrder(result.orderId)).rejects.toThrow();
+    });
+  });
+
+  // ---------- market fills ----------
+
+  describe("market fills", () => {
+    it("fills at the bar's open by default", async () => {
+      await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      broker.processBar(bar(1, 100, 105, 95, 102));
+      const pos = await broker.getPosition("BTCUSDT");
+      expect(pos?.direction).toBe("long");
+      expect(pos?.qty).toBe(10);
+      expect(pos?.avgEntryPrice).toBe(100);
+      expect(updates.at(-1)?.status).toBe("filled");
+      expect(updates.at(-1)?.avgFillPrice).toBe(100);
+    });
+
+    it("fills at the bar's close when processOrdersOnClose is set", async () => {
+      broker = new PaperBrokerAdapter({
+        initialBalance: 10_000,
+        processOrdersOnClose: true,
+      });
+      broker.onOrderUpdate((u) => updates.push(u));
+      await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      broker.processBar(bar(1, 100, 105, 95, 102));
+      const pos = await broker.getPosition("BTCUSDT");
+      expect(pos?.avgEntryPrice).toBe(102);
+    });
+  });
+
+  // ---------- limit / stop fills ----------
+
+  describe("limit fills", () => {
+    it("fills when the bar low reaches the limit (long)", async () => {
+      const order: OrderRequest = {
+        ...marketOrder("o1", "BTCUSDT", "long", 10),
+        orderType: "limit",
+        limitPrice: 95,
+      };
+      await broker.submitOrder(order);
+      broker.processBar(bar(1, 100, 105, 90, 102)); // low 90 <= 95 → fill
+      const pos = await broker.getPosition("BTCUSDT");
+      expect(pos?.avgEntryPrice).toBe(95);
+    });
+
+    it("does not fill when the bar low stays above the limit", async () => {
+      const order: OrderRequest = {
+        ...marketOrder("o1", "BTCUSDT", "long", 10),
+        orderType: "limit",
+        limitPrice: 95,
+      };
+      await broker.submitOrder(order);
+      broker.processBar(bar(1, 100, 105, 96, 102)); // low 96 > 95 → no fill
+      const pos = await broker.getPosition("BTCUSDT");
+      expect(pos).toBeUndefined();
+    });
+  });
+
+  describe("stop fills", () => {
+    it("fills when the bar high reaches the stop (long)", async () => {
+      const order: OrderRequest = {
+        ...marketOrder("o1", "BTCUSDT", "long", 10),
+        orderType: "stop",
+        stopPrice: 105,
+      };
+      await broker.submitOrder(order);
+      broker.processBar(bar(1, 100, 110, 95, 102)); // high 110 >= 105 → fill
+      const pos = await broker.getPosition("BTCUSDT");
+      expect(pos?.avgEntryPrice).toBe(105);
+    });
+  });
+
+  // ---------- reversal / pyramiding ----------
+
+  describe("reversal and pyramiding", () => {
+    it("reverses the position when an entry arrives in the opposite direction", async () => {
+      await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      broker.processBar(bar(1, 100, 105, 95, 102));
+      // Now submit a short for 15 — should close 10 long, open 5 short.
+      await broker.submitOrder(marketOrder("o2", "BTCUSDT", "short", 15));
+      broker.processBar(bar(2, 110, 115, 105, 112));
+      const pos = await broker.getPosition("BTCUSDT");
+      expect(pos?.direction).toBe("short");
+      expect(pos?.qty).toBe(5);
+      expect(pos?.avgEntryPrice).toBe(110);
+      // The fill update should reflect the short entry.
+      const fillUpdate = updates.filter((u) => u.clientId === "o2" && u.status === "filled");
+      expect(fillUpdate).toHaveLength(1);
+    });
+
+    it("pyramids when an entry arrives in the same direction", async () => {
+      await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      broker.processBar(bar(1, 100, 105, 95, 102));
+      await broker.submitOrder(marketOrder("o2", "BTCUSDT", "long", 20));
+      broker.processBar(bar(2, 102, 108, 100, 105));
+      const pos = await broker.getPosition("BTCUSDT");
+      // Avg = (100*10 + 102*20) / 30 = (1000 + 2040) / 30 = 101.333
+      expect(pos?.qty).toBe(30);
+      expect(pos?.avgEntryPrice).toBeCloseTo(3040 / 30, 5);
+    });
+  });
+
+  // ---------- commission / slippage ----------
+
+  describe("commission and slippage", () => {
+    it("applies percent commission and points slippage to fills", async () => {
+      broker = new PaperBrokerAdapter({
+        initialBalance: 10_000,
+        commissionType: "percent",
+        commissionValue: 0.1, // 0.1%
+        slippage: 0.5, // points
+        slippageUnit: "points",
+      });
+      broker.onOrderUpdate((u) => updates.push(u));
+      await broker.submitOrder(marketOrder("o1", "BTCUSDT", "long", 10));
+      broker.processBar(bar(1, 100, 105, 95, 102));
+      const pos = await broker.getPosition("BTCUSDT");
+      expect(pos?.avgEntryPrice).toBeCloseTo(100.5, 5);
+      // Balance decreases by entry commission: 100.5 * 10 * 0.001 = 1.005
+      const balance = await broker.getBalance();
+      expect(balance).toBeCloseTo(10_000 - 1.005, 5);
+    });
+  });
+
+  // ---------- OCA groups ----------
+
+  describe("OCA groups", () => {
+    it("cancels sibling orders when one fills", async () => {
+      const base = marketOrder("base", "BTCUSDT", "long", 10);
+      const oca: OrderRequest = { ...base, clientId: "oca1", ocaName: "grp" };
+      const oca2: OrderRequest = { ...base, clientId: "oca2", ocaName: "grp" };
+      await broker.submitOrder(oca);
+      await broker.submitOrder(oca2);
+      broker.processBar(bar(1, 100, 105, 95, 102));
+      // One of the OCA orders fills; the other is canceled.
+      const statuses = updates.filter((u) => u.status === "filled" || u.status === "canceled");
+      expect(statuses).toHaveLength(2);
+      const filledCount = statuses.filter((u) => u.status === "filled").length;
+      const canceledCount = statuses.filter((u) => u.status === "canceled").length;
+      expect(filledCount).toBe(1);
+      expect(canceledCount).toBe(1);
+    });
+  });
+});
+
+// ---------- StrategyEngine + BrokerAdapter wiring ----------
+
+describe("StrategyEngine + BrokerAdapter wiring", () => {
+  let engine: StrategyEngine;
+  let broker: PaperBrokerAdapter;
+  const submittedOrders: OrderRequest[] = [];
+
+  beforeEach(() => {
+    engine = new StrategyEngine();
+    engine.configure({ title: "TEST", initial_capital: 10_000 });
+    broker = new PaperBrokerAdapter({ initialBalance: 10_000 });
+    submittedOrders.length = 0;
+    const original = broker.submitOrder.bind(broker);
+    broker.submitOrder = (order: OrderRequest) => {
+      submittedOrders.push(order);
+      return original(order);
+    };
+    engine.setBrokerAdapter(broker);
+  });
+
+  it("entry forwards to the broker adapter", () => {
+    engine.entry("long1", "long", 10);
+    expect(submittedOrders).toHaveLength(1);
+    expect(submittedOrders[0]?.clientId).toBe("long1");
+    expect(submittedOrders[0]?.direction).toBe("long");
+    expect(submittedOrders[0]?.qty).toBe(10);
+    expect(submittedOrders[0]?.isExit).toBe(false);
+  });
+
+  it("close forwards to the broker adapter as a market exit", () => {
+    engine.close("long1");
+    expect(submittedOrders).toHaveLength(1);
+    expect(submittedOrders[0]?.clientId).toBe("close_long1");
+    expect(submittedOrders[0]?.orderType).toBe("market");
+    expect(submittedOrders[0]?.isExit).toBe(true);
+  });
+
+  it("setBrokerAdapter(undefined) restores the emulator path", () => {
+    engine.setBrokerAdapter(undefined);
+    engine.entry("long1", "long", 10);
+    expect(submittedOrders).toHaveLength(0);
+  });
+
+  it("getBrokerAdapter returns the installed adapter", () => {
+    expect(engine.getBrokerAdapter()).toBe(broker);
+  });
+});
+
+// ---------- BinanceBrokerAdapter structural typing ----------
+
+describe("BinanceBrokerAdapter structural typing", () => {
+  it("BinanceTradingSurface accepts an in-memory mock implementation", () => {
+    const mock: BinanceTradingSurface = {
+      newOrder: async () => ({
+        orderId: "bin_1",
+        status: "NEW",
+        executedQty: 0,
+        avgPrice: undefined,
+        rejectReason: undefined,
+      }),
+      cancelOrder: async () => undefined,
+      getPosition: async () => undefined,
+      getBalance: async () => 10_000,
+      onOrderUpdate: () => () => undefined,
+    };
+    const adapter: BrokerAdapter = new BinanceBrokerAdapter(mock, { symbol: "BTCUSDT" });
+    expect(adapter).toBeDefined();
+    expect(typeof adapter.submitOrder).toBe("function");
+  });
+});
diff --git a/tests/wave9b-pivot-point-levels.test.ts b/tests/wave9b-pivot-point-levels.test.ts
